# Desarrollo local: copiar como .env y reemplazar valores si hace falta.
# Este archivo es seguro para versionar; .env nunca debe subirse al repositorio.
MYSQL_DATABASE=sofram
MYSQL_USER=sofram
MYSQL_PASSWORD=cambiar-por-password-local
MYSQL_ROOT_PASSWORD=cambiar-root-local
MYSQL_PORT=3306
ADMINER_PORT=8081

# Se usará al implementar autenticación JWT. Debe tener 32 bytes o más.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-bytes
